{
  "name": "ritual-firestore-rules-test",
  "private": true,
  "type": "module",
  "description": "Checks firestore.rules against the Firestore emulator. See docs/CLOUD_SETUP.md.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-ritual --config ../../firebase.json \"node rules.test.mjs ../../firestore.rules\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
